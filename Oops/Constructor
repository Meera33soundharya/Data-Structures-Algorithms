package sorting;

class Student {

    String name;
    int age;
    int mark;

    // Constructor
    Student(String name, int age, int mark) {
        this.name = name;
        this.age = age;
        this.mark = mark;
    }

    void display() {
        System.out.println("Name : " + name);
        System.out.println("Age  : " + age);
        System.out.println("Mark : " + mark);
    }
}

public class Constructor {

    public static void main(String[] args) {

        Student s1 = new Student("Meera", 20, 85);
        Student s2 = new Student("Aravind", 21, 90);

        s1.display();

        System.out.println();

        s2.display();
    }
}
